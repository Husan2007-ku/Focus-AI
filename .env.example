# ─── ILOVA ────────────────────────────────────────────────
APP_NAME=FocusAI
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# ─── MA'LUMOTLAR BAZASI ───────────────────────────────────
DATABASE_URL=postgresql+asyncpg://focusai:focusai@localhost:5432/focusai_db
DATABASE_ECHO=false

# ─── REDIS ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── JWT AUTENTIFIKATSIYA ─────────────────────────────────
JWT_SECRET_KEY=change-me-too-different-from-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── AI (Claude) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
AI_MODEL=claude-sonnet-4-6
AI_DAILY_REQUEST_LIMIT_FREE=3
AI_DAILY_REQUEST_LIMIT_PREMIUM=100

# ─── TO'LOV TIZIMLARI ─────────────────────────────────────
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ─── FIREBASE (Push) ──────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-service-account.json

# ─── SMS OTP (masalan, Eskiz.uz) ──────────────────────────
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_BASE_URL=

# ─── MONITORING ───────────────────────────────────────────
SENTRY_DSN=

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
